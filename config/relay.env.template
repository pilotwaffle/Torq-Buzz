# TORQ Buzz permanent relay env template (C1 — dry-run / prep only)
# Secrets must be injected by operator-controlled secret store; never commit real values.

BUZZ_BIND_ADDR=127.0.0.1:3300
RELAY_URL=ws://127.0.0.1:3300
BUZZ_RELAY_URL=ws://127.0.0.1:3300

BUZZ_HEALTH_BIND_ADDR=127.0.0.1
BUZZ_HEALTH_PORT=8380
BUZZ_METRICS_BIND_ADDR=127.0.0.1
BUZZ_METRICS_PORT=9302

# C5 only: enable when permanent relay start is authorized
BUZZ_AUTO_MIGRATE=false
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=false

# @secret: placeholders — do not put real keys here
# BUZZ_RELAY_PRIVATE_KEY=
# DATABASE_URL=postgres://buzz:CHANGE_ME@127.0.0.1:55432/buzz
# REDIS_URL=redis://127.0.0.1:16379

# Optional deterministic community (C1 prepared; requires runtime wiring if used)
# BUZZ_COMMUNITY_ID=

# Media (C5+)
# BUZZ_S3_ENDPOINT=http://127.0.0.1:19000
# BUZZ_S3_ACCESS_KEY=
# BUZZ_S3_SECRET_KEY=
# BUZZ_S3_BUCKET=buzz-media
# BUZZ_S3_REGION=us-east-1

BUZZ_GIT_REPO_PATH=E:\TORQ-BUZZ\data\relay\git
BUZZ_GIT_PACK_CACHE_PATH=E:\TORQ-BUZZ\data\relay\git-pack-cache
BUZZ_MESH=off
BUZZ_SERVE_GIT_WEB_GUI=false
RUST_LOG=buzz_relay=info
